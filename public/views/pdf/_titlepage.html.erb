
<% title = process_mixed_content(record.finding_aid['title'] || record.display_string, :preserve_newlines => true) %>
<% subtitle = process_mixed_content(record.finding_aid['subtitle'], :preserve_newlines => true) %>

<div class="title-page">
    <div class="logo"><%= image_tag( record.resolved_repository['image_url'] || asset_path("archivesspace.small.png"), {:class => 'logo-img'} ) %></div>
    <div class="title-block">

      <h3 class="title"><%== title %></h3>
      <% if subtitle %>
        <h4 class="subtitle italic"><%== subtitle.gsub(/\b\w+:\s*/, '') %></h4>
      <% end %>

      <% unless record.dates.empty? %>
        <h4 class="dates">
          <% year_range_regex = /\d{4}(?:[-–]\d{4})?/ %>
          <% extracted_dates = record.dates.map { |d| d['final_expression'].scan(year_range_regex).join('–') } %>
          <% main_date = extracted_dates[0] %>
          <% if extracted_dates.length > 1 %>
            <% bulk_date = extracted_dates[1] %>
            <%= "#{main_date} (Bulk dates: #{bulk_date})" %>
          <% else %>
            <%= main_date %>
          <% end %>
        </h4>
      <% end %>

      <h4 class="identifier"><%= record.level.capitalize %> <%= record.identifier %></h4>

    </div>


  <div class="summary-section">
    <h4 class="summary-title">Descriptive Summary</h4>

    <table class="summary-table">
      <tr>
        <td class="summary-item-label">Creator<%= record.raw['creators_text'].present? && record.raw['creators_text'].length > 1 ? 's' : '' %>:</td>
        <td class="summary-item-value"><%= record.raw['creators_text'].present? ? record.raw['creators_text'].join('; ') : '' %></td>
      </tr>
      <tr>
        <td class="summary-item-label">Title:</td>
        <td class="summary-item-value">
          <%= title %>
          <% if subtitle %>
            <span class="italic"><%== subtitle %></span>
          <% end %>
        </td>
      </tr>
      <tr>
        <td class="summary-item-label">Dates:</td>
        <td class="summary-item-value">
          <% year_range_regex = /\d{4}(?:[-–]\d{4})?/ %>
          <% dates = record.dates.map { |d| d['final_expression'].scan(year_range_regex).join('–') } %>
          <% main_date = dates[0] %>
          <% if dates.length > 1 %>
            <% bulk_date = dates[1] %>
            <%= "#{main_date} (Bulk dates: #{bulk_date})" %>
          <% else %>
            <%= main_date %>
          <% end %>
        </td>
      </tr>
      <tr>
        <td class="summary-item-label">Abstract:</td>
        <td class="summary-item-value"><%== process_mixed_content(record.json['notes'].select{|n| n['type'] == 'abstract'}.map{|n| n['content'].join('; ')}.join('; ')) %></td>
      </tr>
      <tr>
        <td class="summary-item-label">Identification:</td>
        <td class="summary-item-value"><%= record.identifier %></td>
      </tr>
      <tr>
        <td class="summary-item-label">Extent:</td>
        <td class="summary-item-value"><%= record.extents.map{|e| e['display'].strip}.join(', ') %></td>
      </tr>
      <tr>
        <td class="summary-item-label">Language:</td>
        <td class="summary-item-value"><%= record.lang_materials.map{|l| t('enumerations.language_iso639_2.' + l['language'])}.join(', ') %></td>
      </tr>
      <tr>
        <td class="summary-item-label">Repository:</td>
        <td class="summary-item-value"><%= record.resolved_repository['name'] %>, <%= record.resolved_repository['parent_institution_name'] %></td>
      </tr>
      <% if record.json['finding_aid_date'] %>
        <tr>
          <td class="summary-item-label">Finding Aid Date:</td>
          <td class="summary-item-value"><%= record.json['finding_aid_date'] %></td>
        </tr>
      <% end %>
      <% if record.json['finding_aid_author'] %>
        <tr>
          <td class="summary-item-label">Finding Aid Author:</td>
          <td class="summary-item-value"><%= record.json['finding_aid_author'] %></td>
        </tr>
      <% end %>
    </table>

  </div>
</div>
