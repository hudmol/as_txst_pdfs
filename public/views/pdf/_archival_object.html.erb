<a name="<%= record.uri %>"></a>

<%# the layout is a table with 5 columns %>
<%# container instances have: %>
<%# | box | folder | content (span=3) | %>
<%# series and subseries levels are shifted in one column for each 'sub' up to 4 %>

<% if record.level.match(/series/i) %>
  <% subdepth = [4, record.level.scan(/sub/i).count].min %>
  <% displaycols = 5 - subdepth %>
  <tr>
    <%== '<td></td>' * subdepth %>
    <% if subdepth == 0 %>
      <td colspan="5">
        <div class="series-entry">Series <%= roman_position %>: <%== process_mixed_content(record.display_string) %></div>
      </td>
    <% else %>
      <% subseries_class = subdepth < 3 ? 'major-subseries-entry' : 'minor-subseries-entry' %>
      <td colspan="<%= displaycols %>">
        <div class="subseries-entry <%= subseries_class %>"><%== process_mixed_content(record.display_string) %></div>
      </td>
    <% end %>
  </tr>

  <% ['scopecontent', 'bioghist'].each do |note_type| %>
    <% if (subnotes = record.notes[note_type]) && subnotes.find{|na| !na['is_inherited']} %>

      <tr>
        <%== '<td></td>' * subdepth %>

        <td colspan="<%= displaycols %>">
          <div class="note-header"><%= I18n.t("enumerations._note_types.#{note_type}") %></div>

          <% subnotes.select{|sn| !sn['is_inherited']}.each do |n| %>
            <% n['note_text'].split(/<br *\/?>/).each do |text| %>
              <p class="note-content"> <%== process_mixed_content(text) %></p>
            <% end %>
          <% end %>
        </td>
      </tr>

    <% end %>
  <% end %>
<% end %>


<% digital_only = !record.instances.find{|i| i['sub_container'].present?} %>

<% Array(record.instances).each do |instance| %>
  <% if first_instance %>
    <tr>
      <td><span class="instance-header">Box</span></td>
      <td><span class="instance-header">Folder</span></td>
      <td></td>
    </tr>
  <% end %>

  <% is_container = instance['sub_container'].present? %>
  <tr>
    <% if is_container %>
      <% top_container = instance['sub_container']['top_container']&.dig('_resolved') %>
      <% indicator_2 = instance['sub_container']['indicator_2'] %>

      <% if indicator_2.present? %>
        <td class="<%= new_box ? 'new-box' : '' %>"><%== top_container&.dig('indicator') %></td>
        <td class="<%= new_box ? 'new-box' : '' %>"><%== indicator_2 %></td>
      <% else %>
        <td class="<%= new_box ? 'new-box' : '' %>" colspan="2">
          <% if top_container&.dig('type') == 'box' %>
            <%== top_container&.dig('indicator') %>
          <% else %>
            <% type_value = top_container&.dig('type') %>
            <% type_text = type_value ? I18n.t("enumerations.instance_instance_type.#{type_value}", default: type_value.capitalize) : '' %>
            <%= type_text %>
            <%== top_container&.dig('indicator') %>
          <% end %>
        </td>
      <% end %>
    <% else %>
      <td class="<%= new_box ? 'new-box' : '' %>" colspan="2">
        <% if digital_only %>
          [ Digital Only ]
        <% end %>
      </td>
    <% end %>

    <td colspan="3" class="<%= new_box ? 'new-box' : '' %>">
      <% if digital_only || is_container %>
        <%== process_mixed_content(record.display_string) %>
      <% end %>

      <% unless is_container %>
        <dl class="additional-metadata">
          <% record.extents.each do |extent| %>
            <% next if extent['_inherited'] %>
            <% if extent['display'] %>
              <dt><%= I18n.t('resource._public.physdesc') %></dt>
              <dd><%= extent['display'] %></dd>
            <% end %>
          <% end %>

          <% if !record.notes.key?('langmaterial') && record.lang_materials.present? %>
            <% record.lang_materials.each do |lang_material| %>
              <% next if lang_material['_inherited'] %>
              <dt><%= I18n.t('resource._public.lang') %></dt>
              <dd><%= t("enumerations.language_iso639_2.#{lang_material['language']}") %></dd>
            <% end %>
          <% end %>

          <%= render partial: 'digital_object_links', locals: { instances: record.instances } %>

          <% subjects = Array(record.subjects).reject { |s| s['is_inherited'] } %>
          <% if subjects.any? %>
            <dt><%= I18n.t('pdf_reports.controlled_access_headings') %></dt>
            <dd>
              <ul>
                <% subjects.each do |subject| %>
                  <li><%= subject['title'] %></li>
                <% end %>
              </ul>
            </dd>
          <% end %>

          <% ASUtils.find_local_directories('public/views/_pdf_archival_object.html.erb').each do |template| %>
            <%= render template: ViewHelper.relative_plugin_view_path(template), locals: { record: record } if File.exist?(template) %>
          <% end %>
        </dl>
      <% end %>
    </td>
  </tr>
<% end %>
